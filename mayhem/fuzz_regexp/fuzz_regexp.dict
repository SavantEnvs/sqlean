# PCRE2/regex metacharacter dictionary for mayhem/fuzz_regexp.
# Harvested from PCRE2 syntax + upstream sqlean's own test/regexp.sql
# patterns, to steer the fuzzer toward interesting regex constructs instead
# of re-discovering them byte-by-byte.
"\\d"
"\\D"
"\\w"
"\\W"
"\\s"
"\\S"
"\\b"
"\\B"
"\\1"
"\\2"
".*"
".+"
".?"
"^"
"$"
"[^"
"]"
"(?:"
"(?="
"(?!"
"(?<="
"(?<!"
"(?i)"
"(?#"
"{1,2}"
"{0,}"
"{2,}"
"*+"
"++"
"?+"
"|"
"\\p{L}"
"\\x{100}"
"(a+)+"
"(a|a)*"
